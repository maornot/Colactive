# Password that opens the site (/gate). Changing it locks out everyone who
# entered it but hasn't registered yet; registered members stay signed in.
SITE_PASSWORD=

# Password for /admin (open/lock guest lists, see members).
ADMIN_PASSWORD=

# Long random string used to sign cookies, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# Supabase — Project Settings → API. Server-only, never exposed to the browser.
# Without these, local dev stores data in .data/club.json.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
