# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service-role key. Server-only — never expose to the client. Used by the
# cron routes and scanner/cli.ts to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend — resend.com/api-keys. Needed to actually send notification emails.
RESEND_API_KEY=re_...
NOTIFICATIONS_FROM_EMAIL="התראות קולאקטייב <notifications@yourdomain.co.il>"

# Shared secret the cron routes check for (Authorization: Bearer <value>).
# Vercel Cron Jobs add this header automatically once this env var is set —
# see https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=

# Used in email templates for the "view all publications" link.
NEXT_PUBLIC_SITE_URL=https://collactive.co.il
